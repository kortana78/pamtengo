# Pamtengo — local development defaults (DEMO values only, never commit real secrets)
DATABASE_URL=sqlite:///./pamtengo.db
# For Postgres (docker compose): DATABASE_URL=postgresql+psycopg://pamtengo:pamtengo@localhost:5432/pamtengo
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO
RATE_LIMIT_PER_MINUTE=120
# AI provider: "mock" (default, deterministic, no key needed) or "openai_compatible"
AI_PROVIDER=mock
AI_TIMEOUT_SECONDS=20
AI_MAX_RETRIES=2
AI_MAX_TOKENS=2000
# Optional live provider (OpenAI-compatible endpoint). Leave empty for mock mode.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
# Dev auth: requests should send X-User-Email header; seed user below is the default approver.
SEED_ADMIN_EMAIL=admin@pamtengo.demo
SEED_ADMIN_ROLE=admin
# Upload limits
CSV_MAX_BYTES=1048576
CSV_MAX_ROWS=1000
NEXT_PUBLIC_API_URL=http://localhost:8000
